"""
agent_policy.py - The Live Self-Modifiable Agent Policy (Gen 2).
Evolved via Gödel Agent Self-Editor with sandbox verification.
"""

from __future__ import annotations
import math
import numpy as np


class AgentPolicy:
    VERSION = "1.2.0"

    deliberation_depth: int = 6
    base_exploration_temp: float = 0.55
    conflict_threshold: float = 0.44
    confidence_decay: float = 0.96

    @classmethod
    def compute_exploration_temperature(
        cls, dopamine: float, norepinephrine: float, conflict: float
    ) -> float:
        # Evolved: Logarithmic uncertainty scaling with dopamine stabilization
        ne_drive = 0.30 * (norepinephrine - 1.0)
        da_focus = 0.20 * (dopamine - 1.0)
        temp = cls.base_exploration_temp + ne_drive - da_focus
        return float(np.clip(temp, 0.1, 2.0))

    @classmethod
    def heuristic_value(
        cls, action_idx: int, context_features: np.ndarray, q_value: float, somatic_valence: float
    ) -> float:
        # Evolved: Gated somatic marker integration preventing deceptive emotional distraction
        somatic_gate = 0.15 if q_value > 0.5 else 0.35
        return float(q_value + somatic_gate * somatic_valence)

    @classmethod
    def evaluate_candidate_plans(cls, candidate_scores: list[float], conflict: float) -> int:
        return int(np.argmax(candidate_scores))
