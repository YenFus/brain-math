"""
agent_policy.py - The Live Self-Modifiable Agent Policy & Heuristics.

This module contains the agent's executable heuristics, decision parameters,
and reasoning search functions. The agent has COMPLETE FREEDOM to inspect,
patch, refactor, and evolve this file via the Gödel Self-Editor.
"""

from __future__ import annotations

import math
import numpy as np


class AgentPolicy:
    """The active policy parameters and decision heuristics."""

    VERSION = "1.0.0"

    # Search & Deliberation Hyperparameters
    deliberation_depth: int = 4
    base_exploration_temp: float = 0.65
    conflict_threshold: float = 0.50
    confidence_decay: float = 0.95

    @classmethod
    def compute_exploration_temperature(
        cls,
        dopamine: float,
        norepinephrine: float,
        conflict: float,
    ) -> float:
        """Dynamically modulate search entropy using neuromodulators and conflict."""
        # High Noradrenaline (vigilance/surprise) and high conflict broaden search
        temp = cls.base_exploration_temp + 0.35 * max(0.0, norepinephrine - 1.0) + 0.20 * conflict
        # Dopamine focuses exploitation when confidence is high
        temp -= 0.15 * max(0.0, dopamine - 1.0)
        return float(np.clip(temp, 0.1, 2.0))

    @classmethod
    def heuristic_value(
        cls,
        action_idx: int,
        context_features: np.ndarray,
        q_value: float,
        somatic_valence: float,
    ) -> float:
        """Heuristic scoring combining learned Q-values with emotional intuition."""
        # Initial baseline heuristic combining Q-value with somatic emotional bias
        score = q_value + 0.3 * somatic_valence
        return float(score)

    @classmethod
    def evaluate_candidate_plans(
        cls,
        candidate_scores: list[float],
        conflict: float,
    ) -> int:
        """Select best candidate plan using softmax with temperature."""
        scores = np.array(candidate_scores, dtype=float)
        temp = max(0.1, cls.base_exploration_temp * (1.0 + conflict))
        scaled = (scores - np.max(scores)) / temp
        probs = np.exp(scaled) / np.sum(np.exp(scaled))
        return int(np.argmax(probs))
